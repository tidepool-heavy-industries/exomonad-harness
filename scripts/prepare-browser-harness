#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
stable_binary="$PWD/target/release/harness-demo"
prepared=false
cleanup() {
  if [[ "$prepared" != true ]]; then
    rm -f "$stable_binary"
  fi
}
trap cleanup EXIT

# Invalidate any previous artifact before even the web preparation starts, so
# every failed attempt leaves the host launcher unable to select stale output.
if ! rm -f "$stable_binary"; then
  echo "could not invalidate previous browser harness binary at $stable_binary" >&2
  exit 1
fi
bash scripts/prepare-browser-check "$(git rev-parse HEAD)"
shell_source="$(mktemp -d)"
trap 'cleanup; rm -rf -- "$shell_source"' EXIT
cp flake.nix flake.lock rust-toolchain.toml "$shell_source/"
nix develop "path:$shell_source#browser" --command \
  bash scripts/prepare-browser-release "$stable_binary"
printf 'Prepared standalone browser harness: %s\n' "$stable_binary"
sha256sum "$stable_binary"
prepared=true
