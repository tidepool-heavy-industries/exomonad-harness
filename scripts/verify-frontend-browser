#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
[[ $# == 0 ]] || { echo "usage: $0" >&2; exit 2; }
if [[ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" ]]; then
  echo "enter the pinned nix develop .#web shell and materialize .#web-chromium" >&2
  exit 2
fi
web_system="$(nix eval --impure --raw --expr builtins.currentSystem)"
declared_node="$(nix eval --raw ".#packages.$web_system.buck-node.outPath")/bin/node"
declared_browser="$(nix eval --raw ".#packages.$web_system.web-chromium.outPath")"
if [[ "$(node -p 'process.execPath')" != "$declared_node" || "$PLAYWRIGHT_BROWSERS_PATH" != "$declared_browser" ]]; then
  echo "frontend verification requires the declared Node and Chromium output paths" >&2
  exit 2
fi
export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
[[ -f .buckconfig.local ]] || { echo "run scripts/buck2-configure.sh after materializing the declared closures" >&2; exit 2; }
buck="${HARNESS_BUCK2:-$(nix eval --raw ".#packages.$web_system.buck2.outPath")/bin/buck2}"
"$buck" build --local-only -c remote.enabled=false //web:check //web:test
export HARNESS_BROWSER_ASSETS
HARNESS_BROWSER_ASSETS="$("$buck" build --local-only -c remote.enabled=false //web:dist --show-full-simple-output -v 0)"
[[ "$HARNESS_BROWSER_ASSETS" = /* && "$HARNESS_BROWSER_ASSETS" != *$'\n'* && -s "$HARNESS_BROWSER_ASSETS/browser-bundle.json" ]] || {
  echo "declared browser bundle was not produced" >&2; exit 2;
}
cache_source="${HARNESS_NPM_CACHE:-$(nix eval --raw ".#packages.$web_system.buck-npm-cache.outPath")}"
if [[ ! -d "$cache_source/_cacache" ]]; then
  echo "materialize nix build .#buck-npm-cache --no-link before frontend verification" >&2
  exit 2
fi
task_cache=$(mktemp -d)
trap 'rm -rf -- "$task_cache"' EXIT
cp -R "$cache_source/." "$task_cache/"
chmod -R u+w "$task_cache"
(cd web && npm ci --offline --ignore-scripts --cache "$task_cache" --no-audit --no-fund)
(cd web && npm run check:browser && npm run test:tooling)
export HARNESS_BROWSER_RUN_ID="$(date -u +%Y%m%dT%H%M%S)-$$"
export HARNESS_BROWSER_EVIDENCE_DIR="$repo_root/target/gui-browser/runs/$HARNESS_BROWSER_RUN_ID"
mkdir -p "$HARNESS_BROWSER_EVIDENCE_DIR"
set +e
(cd web && npm run test:browser)
status=$?
set -e
set +e
node web/e2e/evidence.mjs "$status" "$HARNESS_BROWSER_EVIDENCE_DIR"
evidence_status=$?
set -e
if [[ "$status" -ne 0 ]]; then exit "$status"; fi
exit "$evidence_status"
