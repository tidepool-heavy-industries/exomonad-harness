#!/usr/bin/env python3
"""Build one Buck libtest target and require a nonempty, successful selection."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
from typing import Sequence


TEST_LINE = re.compile(r"^(.+): test$")
TEST_RESULT = re.compile(
    r"^test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; "
    r"(\d+) ignored; (\d+) measured; (\d+) filtered out; finished in .+$"
)


def test_names(output: str) -> set[str]:
    return {
        match.group(1)
        for line in output.splitlines()
        if (match := TEST_LINE.fullmatch(line.strip())) is not None
    }


def buck2(root: Path) -> str:
    """Honor an explicit override; otherwise use this checkout's pinned flake output."""
    override = os.environ.get("BUCK2")
    if override:
        return override
    system = subprocess.check_output(
        ["nix", "eval", "--raw", "--impure", "--expr", "builtins.currentSystem"],
        cwd=root,
        text=True,
    ).strip()
    output = subprocess.check_output(
        ["nix", "eval", "--raw", f".#packages.{system}.buck2.outPath"],
        cwd=root,
        text=True,
    ).strip()
    return str(Path(output) / "bin/buck2")


def source_snapshot(directory: Path) -> tuple[str | None, str | None]:
    head = subprocess.run(["git", "rev-parse", "HEAD"], cwd=directory,
                          text=True, capture_output=True, check=False)
    status = subprocess.run(["git", "status", "--porcelain"], cwd=directory,
                            text=True, capture_output=True, check=False)
    return (head.stdout.strip() if head.returncode == 0 else None,
            status.stdout if status.returncode == 0 else None)


def save(evidence: Path, record: dict) -> None:
    (evidence / "evidence.json").write_text(json.dumps(record, indent=2) + "\n")


def exit_with(returncode: int) -> None:
    if returncode < 0:
        os.kill(os.getpid(), -returncode)
    raise SystemExit(returncode)


def run(argv: Sequence[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", required=True, help="One native rust_test label")
    parser.add_argument("--filter", required=True, help="Libtest name substring")
    parser.add_argument("--expect", type=int, help="Exact runnable and executed count")
    parser.add_argument("--exact", action="store_true", help="Match the complete test name")
    parser.add_argument("--local-only", action="store_true", help="Build without remote actions")
    args = parser.parse_args(argv)
    if not args.target.startswith("//crates/") or ":" not in args.target:
        parser.error("--target must be a //crates/...:NAME label")
    if not args.filter.strip() or args.filter.startswith("-"):
        parser.error("--filter must be nonempty and cannot start with '-'")
    if args.expect is not None and args.expect < 1:
        parser.error("--expect must be positive")

    root = Path(__file__).resolve().parent.parent
    package = root / args.target[2:].split(":", 1)[0]
    if not package.is_dir():
        parser.error("target package does not exist")
    (root / "target").mkdir(exist_ok=True)
    evidence = Path(tempfile.mkdtemp(prefix="focused-buck-", dir=root / "target"))
    source_before, status_before = source_snapshot(root)
    executable_name = buck2(root)
    build = [executable_name, "build", args.target, "--show-full-simple-output", "-v", "0"]
    if args.local_only:
        build.extend(["--local-only", "-c", "remote.enabled=false"])
    record = {
        "source_before": source_before,
        "working_tree_status_before": status_before,
        "target": args.target,
        "filter": args.filter,
        "expected": args.expect,
        "exact": args.exact,
        "build_argv": build,
        "phase": "build",
        "executable": None,
        "sha256": None,
        "matched": [],
        "runnable": [],
        "selected_count": 0,
        "executed_count": None,
        "exit_code": None,
    }
    save(evidence, record)
    print(f"focused test evidence: {evidence / 'evidence.json'}", file=sys.stderr)

    def finish(code: int) -> int:
        source_after, status_after = source_snapshot(root)
        record.update(source_after=source_after, working_tree_status_after=status_after,
                      exit_code=code)
        save(evidence, record)
        return code

    record["buck2"] = executable_name
    built = subprocess.run(build, cwd=root, text=True, capture_output=True, check=False)
    (evidence / "build.log").write_text(built.stdout + built.stderr)
    record["build_exit_code"] = built.returncode
    save(evidence, record)
    sys.stderr.write(built.stderr)
    if built.returncode:
        return finish(built.returncode)
    outputs = [Path(line) for line in built.stdout.splitlines() if line.startswith("/")]
    if len(outputs) != 1 or not outputs[0].is_file():
        print("focused test rejected: expected one executable Buck output", file=sys.stderr)
        record["phase"] = "artifact_rejected"
        return finish(1)

    original = outputs[0].resolve()
    executable = evidence / original.name
    shutil.copy2(original, executable)
    digest = hashlib.sha256(executable.read_bytes()).hexdigest()
    env = os.environ.copy()
    env["CARGO_MANIFEST_DIR"] = str(package)
    selection = [str(executable), args.filter]
    if args.exact:
        selection.append("--exact")
    record.update(executable=str(executable), sha256=digest, selection_argv=selection,
                  phase="listing")
    save(evidence, record)

    list_argv = [*selection, "--list"]
    record["list_argv"] = list_argv
    listed = subprocess.run(list_argv, cwd=package, env=env, text=True,
                            capture_output=True, check=False)
    (evidence / "list.log").write_text(listed.stdout + listed.stderr)
    record["list_exit_code"] = listed.returncode
    save(evidence, record)
    if listed.returncode:
        sys.stderr.write(listed.stdout + listed.stderr)
        return finish(listed.returncode)
    ignored_argv = [*selection, "--list", "--ignored"]
    record["ignored_list_argv"] = ignored_argv
    ignored_list = subprocess.run(ignored_argv, cwd=package, env=env, text=True,
                                  capture_output=True, check=False)
    (evidence / "ignored.log").write_text(ignored_list.stdout + ignored_list.stderr)
    record["ignored_list_exit_code"] = ignored_list.returncode
    save(evidence, record)
    if ignored_list.returncode:
        sys.stderr.write(ignored_list.stdout + ignored_list.stderr)
        return finish(ignored_list.returncode)
    matched = test_names(listed.stdout)
    ignored = test_names(ignored_list.stdout)
    names = matched - ignored
    record.update(matched=sorted(matched), ignored=sorted(ignored & matched),
                  runnable=sorted(names), selected_count=len(names), matched_count=len(matched),
                  ignored_count=len(ignored & matched))
    print(f"focused test selection: {len(matched)} matched, {len(names)} runnable, "
          f"{len(ignored & matched)} ignored in {args.target}")
    if not names or (args.expect is not None and len(names) != args.expect):
        print("focused test rejected: runnable selection count mismatch", file=sys.stderr)
        record["phase"] = "selection_rejected"
        return finish(1)

    command = [*selection, "--nocapture"]
    record.update(run_argv=command, phase="execution")
    save(evidence, record)
    completed = subprocess.run(command, cwd=package, env=env, text=True,
                               capture_output=True, check=False)
    (evidence / "run.log").write_text(completed.stdout + completed.stderr)
    sys.stdout.write(completed.stdout)
    sys.stderr.write(completed.stderr)
    record["run_exit_code"] = completed.returncode
    summaries = [match for line in completed.stdout.splitlines()
                 if (match := TEST_RESULT.fullmatch(line.strip()))]
    record["summaries"] = [tuple(int(value) for value in summary.groups())
                           for summary in summaries]
    if summaries:
        passed, failed, ignored, _, _ = map(int, summaries[0].groups())
        record["executed_count"] = passed + failed
        record["passed_count"] = passed
        record["failed_count"] = failed
        record["ignored_count"] = ignored
    save(evidence, record)
    if completed.returncode:
        return finish(completed.returncode)
    if len(summaries) != 1:
        print("focused test rejected: missing or multiple libtest summaries", file=sys.stderr)
        return finish(1)
    passed, failed, ignored, _, _ = map(int, summaries[0].groups())
    if passed != len(names) or failed or ignored:
        print("focused test rejected: executed count differs from runnable selection", file=sys.stderr)
        return finish(1)
    return finish(0)


if __name__ == "__main__":
    exit_with(run(sys.argv[1:]))
