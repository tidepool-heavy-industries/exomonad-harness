#!/usr/bin/env python3
"""Run one Cargo test target and reject filters with no runnable tests."""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from typing import Sequence


TEST_LINE = re.compile(r"^(.+): test$")
TEST_RESULT = re.compile(
    r"^test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; "
    r"(\d+) ignored; (\d+) measured; (\d+) filtered out; finished in .+$"
)


def test_names(output: str) -> set[str]:
    """Read names from libtest's `--list` format, ignoring benchmarks."""
    return {
        match.group(1)
        for line in output.splitlines()
        if (match := TEST_LINE.fullmatch(line.strip())) is not None
    }


def exit_with(returncode: int) -> None:
    """Preserve subprocess exit codes, including signal termination."""
    if returncode < 0:
        os.kill(os.getpid(), -returncode)
    raise SystemExit(returncode)


def cargo_command(package: str, target: str, filter_text: str) -> list[str]:
    if target == "lib":
        target_args = ["--lib"]
    elif target.startswith("test:"):
        target_args = ["--test", target.removeprefix("test:")]
    else:
        target_args = ["--bin", target.removeprefix("bin:")]
    return ["cargo", "test", "-p", package, *target_args, filter_text]


def run(argv: Sequence[str]) -> int:
    parser = argparse.ArgumentParser(
        description="Run a focused package test after checking its libtest match count."
    )
    parser.add_argument("--package", required=True, help="Cargo package name")
    parser.add_argument(
        "--target",
        required=True,
        help="`lib`, `test:INTEGRATION_TARGET`, or `bin:NAME`",
    )
    parser.add_argument("--filter", required=True, help="Nonempty Cargo test filter")
    args = parser.parse_args(argv)

    if args.target != "lib" and not args.target.startswith(("test:", "bin:")):
        parser.error("--target must be `lib`, `test:NAME`, or `bin:NAME`")
    if args.target.startswith(("test:", "bin:")) and not args.target.split(":", 1)[1]:
        parser.error("Cargo test target name must not be empty")
    if not args.filter.strip():
        parser.error("--filter must not be empty")
    if args.filter.startswith("-"):
        parser.error("--filter must not start with `-`")

    command = cargo_command(args.package, args.target, args.filter)
    all_list = subprocess.run(
        [*command, "--", "--list"], text=True, capture_output=True, check=False
    )
    if all_list.returncode != 0:
        sys.stderr.write(all_list.stdout)
        sys.stderr.write(all_list.stderr)
        return all_list.returncode

    ignored_list = subprocess.run(
        [*command, "--", "--list", "--ignored"],
        text=True,
        capture_output=True,
        check=False,
    )
    if ignored_list.returncode != 0:
        sys.stderr.write(ignored_list.stdout)
        sys.stderr.write(ignored_list.stderr)
        return ignored_list.returncode

    matched = test_names(all_list.stdout)
    ignored = test_names(ignored_list.stdout)
    runnable = matched - ignored
    if not runnable:
        print(
            f"focused test rejected: {len(matched)} matched, "
            f"0 runnable, {len(ignored & matched)} ignored",
            file=sys.stderr,
        )
        return 1

    print(
        f"focused test selection: {len(matched)} matched, {len(runnable)} runnable, "
        f"{len(ignored & matched)} ignored",
        file=sys.stderr,
    )
    completed = subprocess.Popen(command, stdout=subprocess.PIPE, text=True, bufsize=1)
    summaries = []
    assert completed.stdout is not None
    for line in completed.stdout:
        sys.stdout.write(line)
        sys.stdout.flush()
        match = TEST_RESULT.fullmatch(line.rstrip("\r\n"))
        if match is not None:
            summaries.append(tuple(int(value) for value in match.groups()))
    returncode = completed.wait()
    if summaries:
        passed = sum(summary[0] for summary in summaries)
        failed = sum(summary[1] for summary in summaries)
        ignored_run = sum(summary[2] for summary in summaries)
        executed = passed + failed
        print(
            f"focused test execution: {executed} executed, {passed} passed, "
            f"{failed} failed, {ignored_run} ignored",
            file=sys.stderr,
        )
    if returncode != 0:
        return returncode
    if not summaries:
        print("focused test rejected: successful Cargo exit without a libtest result", file=sys.stderr)
        return 1

    if executed == 0:
        print("focused test rejected: successful Cargo exit ran zero tests", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    exit_with(run(sys.argv[1:]))
