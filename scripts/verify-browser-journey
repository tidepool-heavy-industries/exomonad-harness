#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

mode=${1:-check}
case "$mode" in check|--prepare-only) ;; *) echo "usage: $0 [--prepare-only]" >&2; exit 2 ;; esac

if ! command -v npm >/dev/null; then
  echo "verification prerequisite missing: enter 'nix develop .#web' for the pinned Node toolchain" >&2
  exit 2
fi

echo "verification preparation: npm ci"
(cd web && npm ci)
echo "verification preparation: npm run check"
(cd web && npm run check)
echo "verification preparation: npm test"
(cd web && npm test)
echo "verification preparation: npm run build"
(cd web && npm run build)
test -f web/dist/index.html || { echo "verification prerequisite missing: web/dist/index.html" >&2; exit 2; }

if [[ "$mode" == --prepare-only ]]; then exit 0; fi

if ! command -v cargo >/dev/null; then
  echo "backend browser journey prerequisite missing: provide the Rust toolchain" >&2
  exit 2
fi

echo "verification assertion: production HTTP/WebSocket backend browser_journey"
scripts/cargo-focused-test --package harness-demo --target test:browser_journey --filter browser --expect 4
