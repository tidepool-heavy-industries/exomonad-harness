#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
if [[ $# -lt 2 || $# -gt 3 ]]; then
  echo "usage: launch-browser-harness ABSOLUTE_SQLITE_PATH LOOPBACK_ADDR [ABSOLUTE_ASSET_DIR]" >&2
  exit 2
fi
db="$1"
addr="$2"
assets="${3:-$root/web/dist}"
binary="${HARNESS_DEMO_BIN:-$root/target/release/harness-demo}"
[[ "$db" = /* ]] || { echo "database path must be absolute" >&2; exit 2; }
[[ "$assets" = /* ]] || { echo "asset path must be absolute" >&2; exit 2; }
[[ "$binary" = /* ]] || { echo "HARNESS_DEMO_BIN must be an absolute path" >&2; exit 2; }
if [[ ! -x "$binary" ]]; then
  echo "prebuilt harness binary is missing or not executable at $binary; run scripts/prepare-browser-harness" >&2
  exit 1
fi
if [[ ! -s "$assets/index.html" ]]; then
  echo "web assets are missing at $assets; run scripts/prepare-browser-harness" >&2
  exit 1
fi
# A private newly created directory is safe; an existing public path needs an
# explicit operator decision. Never silently change ownership or permissions.
umask 077
parent="$(dirname "$db")"
[[ ! -L "$parent" && ! -L "$db" ]] || { echo "database and parent must not be symlinks" >&2; exit 2; }
mkdir -p -- "$parent"
private_path() {
  local path="$1" mode owner
  [[ ! -L "$path" ]] || { echo "database path must not be a symlink: $path" >&2; return 2; }
  mode="$(stat -c %a -- "$path")"
  owner="$(stat -c %u -- "$path")"
  if [[ "$owner" != "$(id -u)" ]] || (( (8#$mode & 077) != 0 )); then
    echo "database path must be owned by this user and private: $path" >&2
    return 2
  fi
}
private_path "$parent"
for existing in "$db" "$db-wal" "$db-shm"; do
  if [[ -e "$existing" || -L "$existing" ]]; then
    [[ -f "$existing" ]] || { echo "database path must be a regular file: $existing" >&2; exit 2; }
    private_path "$existing"
  fi
done
exec "$binary" --db "$db" --serve "$addr" --assets "$assets"
