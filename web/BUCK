load("@prelude//:rules.bzl", "genrule")
load(":web_rules.bzl", "browser_contract", "npm_dependencies", "web_action")

WEB_TEST_EXCLUDES = ["src/**/*.test.*", "src/**/tests/**", "src/**/fixtures/**", "src/**/test-setup.*"]
WEB_PRODUCTION_SRCS = glob(["src/**/*"], exclude = WEB_TEST_EXCLUDES + ["src/generated/**"]) + [
    "scripts/seal-browser-bundle.mjs",
    "index.html",
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "vite.config.ts",
]
WEB_TEST_SRCS = glob(["src/**/*"], exclude = ["src/generated/**"]) + [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.test.json",
    "vite.config.ts",
]

# This independent source-only leaf uses the production input boundary. Generated
# schema/npm/compilation outputs enter downstream actions, preserving acyclicity.
BROWSER_IDENTITY_SRCS = WEB_PRODUCTION_SRCS + [
    "BUCK",
    "web_rules.bzl",
    "scripts/generate-browser-contract.mjs",
]

genrule(
    name = "browser_source_identity",
    srcs = BROWSER_IDENTITY_SRCS,
    out = "browser-source-identity.json",
    bash = "$(exe toolchains//:python) $(location //scripts:browser_source_identity_issuer) \"$SRCDIR\" \"$OUT\"",
    visibility = ["PUBLIC"],
)

npm_dependencies()
browser_contract()

web_action(name = "check", script = "check:production", output = "check.txt", srcs = WEB_PRODUCTION_SRCS)
web_action(name = "check_tests", script = "check:tests", output = "check-tests.txt", srcs = WEB_TEST_SRCS)
web_action(name = "test", script = "test", output = "test.log", srcs = WEB_TEST_SRCS)
web_action(name = "dist", script = "build", output = "dist", srcs = WEB_PRODUCTION_SRCS, is_directory = True)
