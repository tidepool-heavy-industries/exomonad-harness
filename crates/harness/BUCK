load("@prelude//:rules.bzl", "genrule")
load("//build/rust:profiles.bzl", "rust_binary", "rust_library", "rust_test")
load("//:rust_tests.bzl", "integration_test")

# These are the direct dependencies in crates/harness/Cargo.toml. Reindeer
# supplies one Buck alias for each root dependency from the locked graph.
HARNESS_DEPS = [
    "//crates/harness-presentation:harness_presentation",
    "//crates/harness-schema:harness_schema",
    "//third-party/rust:async-trait",
    "//third-party/rust:axum",
    "//third-party/rust:base64",
    "//third-party/rust:fs2",
    "//third-party/rust:getrandom",
    "//third-party/rust:jsonwebtoken",
    "//third-party/rust:libc",
    "//third-party/rust:sha2",
    "//third-party/rust:blake3",
    "//third-party/rust:futures-util",
    "//third-party/rust:reqwest",
    "//third-party/rust:rusqlite",
    "//third-party/rust:schemars",
    "//third-party/rust:serde",
    "//third-party/rust:serde_json",
    "//third-party/rust:thiserror",
    "//third-party/rust:tracing",
    "//third-party/rust:tokio",
    "//third-party/rust:tokio-util",
    "//third-party/rust:uuid",
]

HARNESS_PRODUCTION_SRCS = glob(
    ["src/**/*.rs"],
    exclude = ["src/**/*_tests.rs", "src/**/tests.rs", "src/**/tests/**", "src/bin/**"],
) + ["src/store/schema.sql"]
HARNESS_TEST_SRCS = glob(
    ["src/**/*.rs", "src/**/fixtures/**"],
    exclude = ["src/bin/**"],
) + ["src/store/schema.sql", "tests/support/replay.rs"]

# The bundle identity covers declared production inputs without forcing source
# hashing or web actions into Rust library compilation.
BROWSER_RUNTIME_SRCS = HARNESS_PRODUCTION_SRCS + ["src/bin/browser_contract_export.rs"]
BROWSER_SOURCE_INPUTS = {source: source for source in BROWSER_RUNTIME_SRCS}
BROWSER_SOURCE_INPUTS.update({
    "Cargo.toml": "Cargo.toml",
    "workspace/Cargo.toml": "//:workspace_cargo_toml",
    "workspace/Cargo.lock": "//:workspace_cargo_lock",
    "workspace/flake.nix": "//:workspace_flake",
    "workspace/flake.lock": "//:workspace_flake_lock",
    "workspace/.buckconfig": "//:workspace_buckconfig",
    "build/rust/profiles.bzl": "//build/rust:profile_policy_source",
    "presentation-source-identity.json": "//crates/harness-presentation:browser_source_identity",
    "schema-source-identity.json": "//crates/harness-schema:browser_source_identity",
    "BUCK": "BUCK",
    "browser-source-identity.json": "//web:browser_source_identity",
    "browser-source-identity.py": "//scripts:browser_source_identity_issuer",
})

genrule(
    name = "browser_source_identity",
    srcs = BROWSER_SOURCE_INPUTS,
    out = "browser-source-identity.json",
    bash = "$(exe toolchains//:python) $(location //scripts:browser_source_identity_issuer) \"$SRCDIR\" \"$OUT\"",
    visibility = ["PUBLIC"],
)

rust_library(
    name = "harness",
    crate = "harness",
    crate_root = "src/lib.rs",
    edition = "2024",
    srcs = HARNESS_PRODUCTION_SRCS,
    deps = HARNESS_DEPS,
    visibility = ["PUBLIC"],
)

rust_test(
    name = "unit_tests",
    crate = "harness",
    crate_root = "src/lib.rs",
    edition = "2024",
    srcs = HARNESS_TEST_SRCS,
    deps = HARNESS_DEPS + ["//third-party/rust:proptest"],
    # The counted focused runner executes from this package directory.
    env = {"HARNESS_PROPTEST_REGRESSIONS": "proptest-regressions/finalize.txt"},
)

rust_binary(
    name = "browser_contract_export",
    crate = "browser_contract_export",
    crate_root = "src/bin/browser_contract_export.rs",
    edition = "2024",
    srcs = ["src/bin/browser_contract_export.rs"],
    deps = [":harness", "//third-party/rust:serde_json"],
    visibility = ["PUBLIC"],
)

genrule(
    name = "browser_contract",
    out = "browser-contract",
    bash = "$(exe :browser_contract_export) \"$OUT\"",
    visibility = ["PUBLIC"],
)

# Integration tests are independent libtest binaries, as in Cargo. Keeping
# them separate makes one suite selectable without rebuilding every test root.
integration_test(name = "adapter_readiness", deps = [":harness"] + HARNESS_DEPS, extra_srcs = ["tests/support/replay.rs"])
integration_test(name = "correction_wave", deps = [":harness"] + HARNESS_DEPS)
integration_test(name = "custom_cell", deps = [":harness"] + HARNESS_DEPS)
integration_test(name = "external_cancellation", deps = [":harness"] + HARNESS_DEPS)
integration_test(name = "first_request_delivery", deps = [":harness"] + HARNESS_DEPS, extra_srcs = ["tests/support/replay.rs"])
integration_test(name = "job_operations", deps = [":harness"] + HARNESS_DEPS)
integration_test(name = "plain_text_compaction", deps = [":harness"] + HARNESS_DEPS)
integration_test(name = "process_recovery", deps = [":harness"] + HARNESS_DEPS)
integration_test(name = "progress_cancel", deps = [":harness"] + HARNESS_DEPS)
integration_test(name = "tree_driver", deps = [":harness"] + HARNESS_DEPS)

rust_binary(
    name = "cache_probe",
    crate = "cache_probe",
    crate_root = "src/bin/cache_probe.rs",
    edition = "2024",
    srcs = ["src/bin/cache_probe.rs"],
    deps = [":harness"] + HARNESS_DEPS,
    visibility = ["PUBLIC"],
)
